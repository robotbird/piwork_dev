{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": { "$type": "color", "$value": "#FFFFFF" },
    "surface": {
      "subtle": { "$type": "color", "$value": "#F7F7F8" },
      "muted": { "$type": "color", "$value": "#EFEFF0" },
      "strong": { "$type": "color", "$value": "#E3E3E5" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#ECECEE" },
      "default": { "$type": "color", "$value": "#DEDFE2" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#171719" },
      "secondary": { "$type": "color", "$value": "#67676C" },
      "tertiary": { "$type": "color", "$value": "#929298" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#3B82F6" },
      "hover": { "$type": "color", "$value": "#2563EB" },
      "soft": { "$type": "color", "$value": "#EAF3FF" }
    },
    "success": { "$type": "color", "$value": "#18A957" },
    "warning": { "$type": "color", "$value": "#B7791F" },
    "danger": {
      "default": { "$type": "color", "$value": "#E5484D" },
      "soft": { "$type": "color", "$value": "#FFECEE" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "14px" },
    "xl": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgb(0 0 0 / 5%), 0 8px 24px 0 rgb(0 0 0 / 7%)"
    },
    "modal": {
      "$type": "shadow",
      "$value": "0 18px 55px 0 rgb(0 0 0 / 16%), 0 2px 8px 0 rgb(0 0 0 / 8%)"
    },
    "composer": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgb(0 0 0 / 4%), 0 8px 24px 0 rgb(0 0 0 / 5%)"
    }
  },
  "layout": {
    "sidebarWidth": { "$type": "dimension", "$value": "260px" },
    "sidebarCollapsedWidth": { "$type": "dimension", "$value": "48px" },
    "chatContentMax": { "$type": "dimension", "$value": "832px" },
    "settingsContentMax": { "$type": "dimension", "$value": "960px" },
    "composerMax": { "$type": "dimension", "$value": "832px" },
    "composerEmptyMinHeight": { "$type": "dimension", "$value": "128px" },
    "composerConversationMinHeight": { "$type": "dimension", "$value": "64px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "default": { "$type": "duration", "$value": "180ms" },
    "panel": { "$type": "duration", "$value": "240ms" }
  }
}
