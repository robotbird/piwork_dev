DEEPSEEK_API_KEY=your-deepseek-api-key
AUTH_SECRET=replace-with-a-random-secret
POSTGRES_URL=postgresql://user:password@host:5432/database

# Optional: enables rate limiting and resumable streams.
REDIS_URL=

# Optional: 附件存储。配置 Vercel Blob token 时附件上传到 Vercel Blob；
# 未配置时自动落盘到本地 UPLOAD_DIR（默认 .uploads/），通过 /api/files/:id 访问。
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=

# Optional: 设为任意非空值时禁用 agent 的 bash/read/write/edit 执行工具与
# deliver_file 交付工具（skill 仅保留说明加载，不执行脚本）。
# 适用于不受信的多用户部署环境。
# PIWORK_DISABLE_EXECUTION_TOOLS=
