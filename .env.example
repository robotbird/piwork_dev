DEEPSEEK_API_KEY=your-deepseek-api-key
AUTH_SECRET=replace-with-a-random-secret
POSTGRES_URL=postgresql://user:password@host:5432/database

# Platform web search (Tavily only). Restart after changing; defaults off.
# Queries are sent to Tavily. Credentials stay on the trusted host.
# Pure search uses the lightweight matrix lane; no third-party extension loading.
# No arbitrary webpage fetching. RPC/all and Durable do not support this tool.
# PIWORK_WEB_SEARCH_ENABLED=1
# TAVILY_API_KEY=tvly-your-api-key

# Optional: 附件存储。配置 Vercel Blob token 时附件上传到 Vercel Blob；
# 未配置时自动落盘到本地 UPLOAD_DIR（默认 .uploads/），通过 /api/files/:id 访问。
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=

# Optional: 设为任意非空值时禁用 agent 的 bash/read/write/edit 执行工具与
# deliver_file 交付工具（skill 仅保留说明加载，不执行脚本）。
# 适用于不受信的多用户部署环境。
# PIWORK_DISABLE_EXECUTION_TOOLS=

# Enable only on the single long-lived Node server hosting RunManager.
SCHEDULED_TASKS_ENABLED=false
# Optional bearer secret for external POST /api/scheduled-tasks/execute.
SCHEDULED_TASKS_API_KEY=

# ------------------------------------------------------------------
# Sandbox runtime（本地/单机运行手册见 docs/operations.md；均可选，
# 不设置 = 全部 in-process，行为不变）
# ------------------------------------------------------------------
# PIWORK_SANDBOX_PROVIDER=opensandbox            # docker | opensandbox；缺省 in-process
# PIWORK_SANDBOX_ROUTING=matrix                  # matrix（默认）| all
# PIWORK_SANDBOX_IMAGE=pi-runtime:dev
# PIWORK_SANDBOX_CLI_PATH=/opt/pi/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js
# PIWORK_SANDBOX_TTL_SECONDS=3600
# OPENSANDBOX_DOMAIN=127.0.0.1:8080
# OPENSANDBOX_PROTOCOL=http
# OPENSANDBOX_API_KEY=replace-with-server-api-key
# 沙箱视角的模型代理地址（宿主当前局域网 IP；host.docker.internal 在 Clash fake-IP 下不可用）
# PIWORK_INFERENCE_URL=http://192.168.x.x:3210
# PIWORK_INFERENCE_PROXY_HOST=0.0.0.0
# PIWORK_INFERENCE_PROXY_PORT=3210
# PIWORK_INFERENCE_EGRESS_ALLOWLIST=             # 逗号分隔 FQDN 基线

# ------------------------------------------------------------------
# Non-production automatic Durable + Sandbox chat routing.
# Requires NODE_ENV=development|test, enabled regular members,
# the provider config above, and private persistent absolute directories.
# Development admits all enabled regular members; no user whitelist/checkbox needed.
# Chat classifier routes portable execution to Durable; pure chat stays lightweight.
# Known platform integrations/approvals/uncertainty retain the existing route.
# Test requires the UUID whitelist below; development ignores it.
# Never set PIWORK_RUNTIME_BACKEND=durable for this lane. Production rejects it.
# Defaults off; no Worker, auto recovery, Skill/MCP/Package or schedules.
# See docs/durable-sandbox-composition.md; restart the dev server after changes.
# PIWORK_DURABLE_CHAT_ENABLED=1
# PIWORK_DURABLE_CHAT_USER_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PIWORK_DURABLE_STORAGE_DIR=/absolute/private/durable
# UPLOAD_DIR=/absolute/path/to/existing/uploads

# Optional official Pi classifier. Without model config, uses local pi-auto-router heuristics.
# PIWORK_CLASSIFIER_MODEL=typesafe/jev-latest
# TYPESAFE_API_KEY=
# Alternative: openrouter/typesafe/jev-1.13 with OPENROUTER_API_KEY
