{
  "name": "chatbot",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "tsx lib/db/migrate && next build",
    "start": "next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "scripts:create-daily-report": "tsx scripts/create-daily-report-task.ts",
    "plugin:package": "tsx scripts/package-plugin.mts",
    "plugin:verify": "tsx tests/integration/plugin-chain.mts",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/ai/*.test.ts tests/unit/mcp/*.test.ts tests/unit/pi-packages/*.test.ts",
    "test:runtime:durable": "node --conditions=react-server --import tsx --test tests/unit/runtime/backends/durable/*.test.ts",
    "test:runtime:durable-chat": "node --conditions=react-server --import tsx --test tests/unit/runtime/backends/durable/chat-*.test.ts tests/unit/runtime/backends/explicit-durable.test.ts tests/unit/chat/durable-request.test.ts tests/unit/chat/automatic-routing.test.ts",
    "test:runtime:durable-chat:db": "node --conditions=react-server --import tsx --test --test-force-exit tests/unit/db/durable-chat-queries.test.ts",
    "test:runtime:durable-chat:http": "node --conditions=react-server --import tsx tests/e2e/durable-chat-http.mts",
    "test:runtime:durable-sandbox": "node --conditions=react-server --import tsx --test tests/unit/runtime/backends/durable/sandbox-*.test.ts tests/unit/runtime/backends/durable/opensandbox-composition.test.ts tests/unit/runtime/sandbox/opensandbox-provider.test.ts",
    "test:runtime:foundation": "node --conditions=react-server --import tsx --test tests/unit/runtime/protocol/*.test.ts tests/unit/runtime/sandbox/lazy.test.ts tests/unit/runtime/sandbox/operation-error.test.ts",
    "test:runtime:tools": "node --conditions=react-server --import tsx --test tests/unit/runtime/sandbox/filesystem.test.ts tests/unit/runtime/backends/sandbox-tools/*.test.ts",
    "test:runtime": "node --conditions=react-server --import tsx --test tests/unit/runtime/protocol/*.test.ts tests/unit/runtime/backends/*.test.ts tests/unit/runtime/backends/durable/*.test.ts tests/unit/runtime/backends/local-rpc/*.test.ts tests/unit/runtime/backends/sandbox-rpc/*.test.ts tests/unit/runtime/backends/sandbox-tools/*.test.ts tests/unit/runtime/inference-proxy/*.test.ts tests/unit/runtime/run/*.test.ts tests/unit/runtime/sandbox/*.test.ts tests/unit/chat/*.test.ts tests/unit/admin/*.test.ts",
    "test:runtime:db": "node --conditions=react-server --import tsx --test --test-force-exit tests/unit/db/*.test.ts",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:documents:db": "node --conditions=react-server --import tsx --test --test-force-exit tests/unit/db/library-queries.test.ts",
    "test:documents:http": "node --import tsx tests/e2e/library-http.mts",
    "test:scheduler": "node --conditions=react-server --import tsx --test tests/unit/scheduler/*.test.ts",
    "test:scheduler:db": "node --conditions=react-server --import tsx --test --test-force-exit tests/unit/db/scheduled-task-queries.test.ts",
    "test:scheduler:http": "node --import tsx tests/e2e/scheduled-tasks-http.mts",
    "test:sandboxes:http": "node --conditions=react-server --import tsx tests/e2e/sandboxes-http.mts",
    "test:profile:db": "node --conditions=react-server --import tsx --test --test-force-exit tests/unit/db/profile-queries.test.ts",
    "test:profile": "playwright test tests/e2e/auth.test.ts tests/e2e/profile.test.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.2",
    "@ai-sdk/react": "4.0.16",
    "@alibaba-group/opensandbox": "^1.1.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.5",
    "@earendil-works/chord": "1.0.2",
